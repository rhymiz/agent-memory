{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Hosted Agent Memory service. The production domain and Cloudflare account
  // are supplied at deploy time (see README), not committed here.
  "name": "agent-memory",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "tsconfig": "tsconfig.worker.json",
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "AccountMemory" },
      { "name": "CREDENTIALS", "class_name": "CredentialRegistry" },
    ],
  },
  "exports": {
    "AccountMemory": { "type": "durable-object", "storage": "sqlite" },
    "CredentialRegistry": { "type": "durable-object", "storage": "sqlite" },
  },
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "KEY_RATE_LIMIT",
      "namespace_id": "4801",
      "simple": { "limit": 600, "period": 60 },
    },
  ],
  "secrets": { "required": ["AGENT_MEMORY_ADMIN_TOKEN"] },
  "vars": {
    "DEFAULT_CLAIM_TTL_SECONDS": "1800",
    "MAX_CLAIM_TTL_SECONDS": "3600",
  },
  "observability": { "enabled": true },
}
